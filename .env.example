# Hanicar Jobs - copy to .env and adjust
HJ_DATABASE_URL=postgresql+asyncpg://hanicar:hanicar@postgres:5432/hanicar_jobs
HJ_DATABASE_URL_SYNC=postgresql+psycopg2://hanicar:hanicar@postgres:5432/hanicar_jobs
HJ_REDIS_URL=redis://redis:6379/0
HJ_SECRET_KEY=change-me-in-production-use-long-random-string
HJ_AI_ENABLED=true
HJ_LLM_PROVIDER=auto
HJ_GROQ_API_KEY=
HJ_GEMINI_API_KEY=
# OpenRouter free-tier key – sign up at https://openrouter.ai (no billing needed for free models)
HJ_OPENROUTER_API_KEY=
HJ_OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
HJ_POLLINATIONS_MODEL=openai-fast
HJ_AUTO_DRAFT_ENABLED=true
HJ_AUTO_POLISH_WITH_LLM=true
HJ_MULTI_USER=false
HJ_CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
HJ_COPYRIGHT=(c) 2026 Safwen Amaira = Born as root
HJ_APP_NAME=Hanicar Jobs
HJ_TAGLINE=Don't search. Hunt.
HJ_ENV=development
HJ_LOG_LEVEL=INFO
HJ_SMTP_HOST=smtp.gmail.com
HJ_SMTP_PORT=587
HJ_SMTP_USERNAME=
HJ_SMTP_PASSWORD=
HJ_SMTP_FROM_EMAIL=
HJ_SMTP_FROM_NAME=Hanicar Jobs
HJ_SMTP_USE_TLS=true
POSTGRES_USER=hanicar
POSTGRES_PASSWORD=hanicar
POSTGRES_DB=hanicar_jobs
